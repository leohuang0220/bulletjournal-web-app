rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    match /families/{fid} {
      allow create: if signedIn() && myEmail() in request.resource.data.emails;
      allow read, update, delete: if signedIn() && myEmail() in resource.data.emails;
      match /{col}/{doc} {
        allow read, write: if signedIn() && myEmail() in get(/databases/$(database)/documents/families/$(fid)).data.emails;
      }
    }
  }
}
